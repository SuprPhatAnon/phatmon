# Add to ~/consumable/.envrc and review before running direnv allow.
export CODEX_HOME="$HOME/.codex-homes/consumable"
export CODEX_REMOTE="ws://127.0.0.1:4500"

# To follow the installer's saved mapping, replace both exports with:
# source_env "$HOME/.codex-homes/consumable/phatmon.env"
# With the codex.zsh function in ~/.zshrc, just run: codex
# Without the function: codex --remote "$CODEX_REMOTE" --cd "$PWD"
